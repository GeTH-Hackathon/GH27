{
  "name": "geth-hackathon-web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "data": "node scripts/build-data.mjs && node scripts/build-graph.mjs",
    "prestart": "npm run data",
    "prebuild": "npm run data",
    "start": "astro dev --port 3000",
    "build": "astro build",
    "serve": "astro preview --port 3000",
    "typecheck": "astro check",
    "test": "node --test scripts/build-data.test.mjs scripts/workflow.test.mjs scripts/filter.test.mjs scripts/paginate.test.mjs scripts/build-graph.test.mjs scripts/barcode.test.mjs",
    "test:site": "node --test scripts/site.test.mjs",
    "test:smoke": "node --test --test-concurrency=1 scripts/smoke.test.mjs"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.2",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/inter-tight": "^5.3.0",
    "astro": "^7.4.5",
    "clsx": "^2.0.0",
    "gsap": "^3.15.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/react": "^19.0.0",
    "d3-force": "^3.0.0",
    "playwright": "^1.63.0",
    "typescript": "~6.0.2"
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
