---
import Base from '../layouts/Base.astro';
import Home from '../components/Home';
import {event} from '../data/event';

// schema.org Event so search engines can show the date, place and organiser as a rich result.
const eventJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: event.name,
  description: event.description,
  startDate: event.startDate,
  endDate: event.endDate,
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  inLanguage: 'en',
  url: new URL(import.meta.env.BASE_URL, Astro.site).href,
  image: new URL(`${import.meta.env.BASE_URL}img/og.png`, Astro.site).href,
  location: {
    '@type': 'Place',
    name: event.venue.name ?? `${event.venue.city}, ${event.venue.country}`,
    address: {'@type': 'PostalAddress', addressLocality: event.venue.city, addressCountry: 'TH'},
  },
  organizer: event.partners
    .filter((p) => p.role === 'Organizer')
    .map((p) => ({'@type': 'Organization', name: p.name, ...(p.href ? {url: p.href} : {})})),
};
---
<Base title="Genomics hackathon, Chiang Mai 2027" description={event.description}>
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(eventJsonLd)} />
  <Home client:load />
</Base>
